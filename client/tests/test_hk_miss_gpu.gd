extends SceneTree
## Local-only visible GPU proof for the source-backed HK MISS sprite.
## The private source PNG is generated by tools/ui_art/sync_hk_combat_ui.py.
const WorldCanvas = preload("res://world/world_canvas.gd")
const UiTextureLoader = preload("res://ui/ui_texture_loader.gd")
const MISS_PATH := "res://ui/private_ie_hk2/MISS.png"

func _fail(reason: String) -> void:
	push_error("HK_MISS_GPU_FAIL "+reason)
	quit(1)

func _initialize() -> void:
	DisplayServer.window_set_title("SGTest HK MISS GPU Proof")
	DisplayServer.window_set_size(Vector2i(800,600))
	root.size = Vector2i(800,600)
	_run.call_deferred()

func _run() -> void:
	var args := OS.get_cmdline_user_args()
	if args.size() < 1:
		_fail("output path missing")
		return
	var texture := UiTextureLoader.get_texture(MISS_PATH)
	if texture == null or texture.get_size() != Vector2(45,35):
		_fail("source MISS texture missing or wrong geometry")
		return
	var canvas := WorldCanvas.new()
	root.add_child(canvas)
	canvas.present([],[],[{
		"p":Vector2(400.0,280.0),
		"text":"MISS",
		"miss":true,
		"alpha":1.0
	}],[])
	await process_frame
	await RenderingServer.frame_post_draw
	var output := str(args[0])
	var capture := root.get_texture().get_image()
	if capture.get_width()!=800 or capture.get_height()!=600:
		_fail("viewport is not 800x600 actual=%dx%d" % [capture.get_width(),capture.get_height()])
		return
	if capture.save_png(output) != OK:
		_fail("capture write failed")
		return
	print("HK_MISS_GPU_PASS viewport=800x600 sprite=45x35 origin=-7,0 capture="+output)
	# Keep the native window available long enough for external visible-window
	# inspection; automation may terminate this process after capturing evidence.
	for _frame in range(1800):
		await process_frame
	quit(0)
